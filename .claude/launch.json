{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "raaziq-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "raaziq-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--port", "5173"],
      "port": 5173
    }
  ]
}
