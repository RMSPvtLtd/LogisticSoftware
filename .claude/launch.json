{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "raaziq-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "sea-and-air/air", "uvicorn", "main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "raaziq-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "sea-and-air/air/frontend", "--", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "raaziq-sea-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "sea-and-air/sea", "uvicorn", "main:app", "--app-dir", "backend", "--port", "8001"],
      "port": 8001
    }
  ]
}
