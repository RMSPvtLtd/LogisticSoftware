# Copy to .env and adjust. .env is never committed.

# Comma-separated origins allowed to call the API from a browser. In
# practice the air frontend's dev server proxies /sea-api/* here
# server-side, so the browser itself never calls this cross-origin.
CORS_ORIGINS=http://localhost:5173

# SAPT container tracking provider.
SAPT_BASE_URL=https://www.sapt.com.pk/Enquiries/ContainerHistory
SAPT_REQUEST_TIMEOUT_SECONDS=10.0

# How long an identical container lookup is served from cache before
# hitting SAPT again.
TRACKING_CACHE_TTL_SECONDS=120
